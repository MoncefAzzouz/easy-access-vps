{
  "name": "easy-vps",
  "displayName": "Easy VPS",
  "description": "Browse and edit VPS files in VS Code Explorer over SSH/SFTP.",
  "version": "0.2.5",
  "engines": {
    "vscode": "^1.107.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "ssh",
    "sftp",
    "vps",
    "remote",
    "filesystem"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onView:easyVps.connections",
    "onCommand:easy-vps.add",
    "onCommand:easy-vps.removeFromExplorer",
    "onCommand:easy-vps.connect",
    "onCommand:easy-vps.disconnect",
    "onCommand:easy-vps.forgetConnection",
    "onFileSystem:easy-vps"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "easyVps",
          "title": "Easy VPS",
          "icon": "resources/server.svg"
        }
      ]
    },
    "views": {
      "easyVps": [
        {
          "id": "easyVps.connections",
          "name": "Connections"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "easyVps.connections",
        "contents": "Connect in two steps: enter user@host, then your password.\n[Add VPS](command:easy-vps.add)\n[Import SSH Config](command:easy-vps.importSshConfig)"
      }
    ],
    "commands": [
      {
        "command": "easy-vps.add",
        "title": "Add VPS",
        "category": "Easy VPS",
        "icon": "$(add)"
      },
      {
        "command": "easy-vps.connect",
        "title": "Connect to VPS",
        "category": "Easy VPS",
        "icon": "$(remote)"
      },
      {
        "command": "easy-vps.disconnect",
        "title": "Disconnect VPS",
        "category": "Easy VPS"
      },
      {
        "command": "easy-vps.forgetConnection",
        "title": "Forget Saved Connection",
        "category": "Easy VPS"
      },
      {
        "command": "easy-vps.advancedAdd",
        "title": "Add VPS (Advanced)",
        "category": "Easy VPS"
      },
      {
        "command": "easy-vps.test",
        "title": "Test Connection",
        "category": "Easy VPS",
        "icon": "$(pulse)"
      },
      {
        "command": "easy-vps.edit",
        "title": "Edit Connection",
        "category": "Easy VPS",
        "icon": "$(edit)"
      },
      {
        "command": "easy-vps.openPath",
        "title": "Open Remote Path",
        "category": "Easy VPS"
      },
      {
        "command": "easy-vps.importSshConfig",
        "title": "Import from SSH Config",
        "category": "Easy VPS"
      },
      {
        "command": "easy-vps.refresh",
        "title": "Refresh Connections",
        "category": "Easy VPS",
        "icon": "$(refresh)"
      },
      {
        "command": "easy-vps.removeFromExplorer",
        "title": "Remove VPS from Explorer",
        "category": "Easy VPS",
        "icon": "$(close)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "easy-vps.add",
          "when": "view == easyVps.connections",
          "group": "navigation@1"
        },
        {
          "command": "easy-vps.refresh",
          "when": "view == easyVps.connections",
          "group": "navigation@2"
        },
        {
          "command": "easy-vps.connect",
          "when": "view == workbench.explorer.fileView",
          "group": "navigation@1"
        }
      ],
      "view/item/context": [
        {
          "command": "easy-vps.connect",
          "when": "view == easyVps.connections",
          "group": "inline@1"
        },
        {
          "command": "easy-vps.test",
          "when": "view == easyVps.connections",
          "group": "easyVps@1"
        },
        {
          "command": "easy-vps.edit",
          "when": "view == easyVps.connections",
          "group": "easyVps@2"
        },
        {
          "command": "easy-vps.forgetConnection",
          "when": "view == easyVps.connections",
          "group": "easyVps@3"
        }
      ],
      "explorer/context": [
        {
          "command": "easy-vps.removeFromExplorer",
          "when": "resourceScheme == easy-vps",
          "group": "easyVps@100"
        }
      ],
      "commandPalette": [
        { "command": "easy-vps.add" },
        { "command": "easy-vps.advancedAdd" },
        { "command": "easy-vps.importSshConfig" },
        {
          "command": "easy-vps.connect"
        },
        {
          "command": "easy-vps.disconnect",
          "when": "workspaceFolderCount > 0"
        },
        {
          "command": "easy-vps.forgetConnection"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/ssh2": "^1.15.5",
    "@types/vscode": "^1.107.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.28.1",
    "eslint": "^10.5.0",
    "npm-run-all": "^4.1.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1"
  },
  "dependencies": {
    "ssh2": "^1.17.0"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
